---
import { SEO } from "astro-seo"

interface Props {
  title: string
}

const { title } = Astro.props

const DEFAULT_TITLE_PAGE = "Flávio Zanoni - Portfolio"
const DEFAULT_DESCRIPTION_PAGE =
  "OS-like portfolio showcasing projects, skills, and resume."
const DEFAULT_URL_SITE = "https://frav.in"
const DEFAULT_IMAGE =
  "https://raw.githubusercontent.com/FlavioZanoni/FlavioZanoni.com/main/public/og.png"

const openGraph = {
  title: title || DEFAULT_TITLE_PAGE,
  type: "website",
  image: DEFAULT_IMAGE,
  alt: "Site logo - CRT monitor",
  url: DEFAULT_URL_SITE,
  description: DEFAULT_DESCRIPTION_PAGE,
}
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      charset="UTF-8"
      title={openGraph.title}
      description={openGraph.description}
      openGraph={{
        basic: {
          title: openGraph.title,
          type: openGraph.type,
          image: openGraph.image,
          url: openGraph.url,
        },
        image: {
          alt: openGraph.alt,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: openGraph.title,
        description: openGraph.description,
        image: openGraph.image,
        imageAlt: openGraph.alt,
      }}
      extend={{
        link: [
          { rel: "icon", href: "/favicon/favicon.ico" },
          { rel: "icon", sizes: "16x16", href: "/favicon/favicon-16x16.png" },
          { rel: "icon", sizes: "32x32", href: "/favicon/favicon-32x32.png" },
          { rel: "manifest", href: "/manifest.webmanifest" },
          { rel: "sitemap", href: "/sitemap-index.xml" },
          { rel: "canonical", href: DEFAULT_URL_SITE },
        ],
        meta: [
          { name: "viewport", content: "width=device-width, initial-scale=1" },
          { name: "generator", content: Astro.generator },
          { name: "author", content: "Flávio Zanoni" },
          { name: "robots", content: "index, follow" },
          { property: "og:site_name", content: DEFAULT_TITLE_PAGE },
          { property: "og:locale", content: "en_US" },
          { property: "og:locale:alternate", content: "pt_BR" },
        ],
      }}
    />

    <meta
      http-equiv="Content-Security-Policy"
      content="upgrade-insecure-requests"
    />

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Flávio Zanoni",
        "url": "https://frav.in",
        "image": "https://raw.githubusercontent.com/FlavioZanoni/FlavioZanoni.com/main/public/og.png",
        "description": "OS-like portfolio showcasing projects, skills and resume.",
        "sameAs": [
          "https://github.com/FlavioZanoni",
          "https://www.linkedin.com/in/flaviozanoni/"
        ],
        "jobTitle": "Embedded Developer/ Frontend Developer",
        "worksFor": {
          "@type": "Organization",
          "name": "Folhastech"
        }
      }
    </script>

    <!-- Analytics -->
    <script
      is:inline
      defer
      data-domain="frav.in"
      src="https://analytics.frav.in/js/script.js"></script>

    <!-- Styles -->
    <link rel="stylesheet" href="retroStyle.css" />
    <link rel="stylesheet" href="scrollbar.css" />
  </head>
  <body class="flex flex-col justify-between font-display overflow-clip h-svh">
    <slot />
  </body>
</html>
