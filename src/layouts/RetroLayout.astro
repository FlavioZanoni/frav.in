---
interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-16" />
    <meta name="description" content="Flávio Zanoni - Portifolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.ico" />
    <link rel="icon" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="retroStyle.css" />
    <link rel="stylesheet" href="scrollbar.css" />

    <meta name="author" content="Flávio Zanoni" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://frav.in" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- analytics -->
    <script
      defer
      data-domain="frav.in"
      src="https://plausible-analytics.yoshuu.com/js/script.file-downloads.outbound-links.js"
    ></script>

    <!-- schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Flávio Zanoni",
        "url": "https://frav.in",
        "image": "https://frav.in/favicon/android-chrome-512x512.png",
        "description": "OS-like portfolio showcasing projects, skills, and resume.",
        "sameAs": [
          "https://github.com/FlavioZanoni",
          "https://www.linkedin.com/in/flaviozanoni/"
        ],
        "jobTitle": "Frontend Developer",
        "worksFor": {
          "@type": "Organization",
          "name": "Folhastech"
        }
      }
    </script>

    <!-- OG -->
    <meta property="og:site_name" content="Flávio Zanoni - Portfolio" />
    <meta property="og:title" content="Flávio Zanoni - Portfolio" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://frav.in" />
    <meta
      property="og:image"
      content="https://frav.in/favicon/android-chrome-512x512.png"
    />
    <meta property="og:image:alt" content="Site logo - CRT monitor" />
    <meta
      property="og:description"
      content="OS like portfolio, showing my projects and resume"
    />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:title" content="Flávio Zanoni - Portfolio" />
    <meta
      name="twitter:description"
      content="OS like portfolio, showing my projects and resume"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image"
      content="https://frav.in/favicon/android-chrome-512x512.png"
    />
    <meta name="twitter:image:alt" content="Site logo - CRT monitor" />
  </head>
  <body class="flex flex-col justify-between font-display overflow-clip">
    <slot />
  </body>
</html>
