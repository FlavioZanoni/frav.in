---
import dayjs from "dayjs"
import isBefore from "dayjs/plugin/isSameOrBefore"
import Layout from "../layouts/Layout.astro"
import type { MDXInstance } from "astro"
dayjs.extend(isBefore)

interface Frontmatter {
  title?: string
  status?: string
  start?: string
}

const projects = Object.values(
  import.meta.glob<MDXInstance<Frontmatter>>("./projects/*.mdx", {
    eager: true,
  })
)
---

<script>
  const urlParams = new URLSearchParams(window.location.search)
  const isInOs = urlParams.get("isInOS")

  if (isInOs === "true") {
    document.getElementById("osLink").innerHTML = `
      <a href="/projects" target="_blank" class=" text-[#2aadad]">Hard to read inside the OS? Click here to view in another browser tab</a>
    `
  }

  document.querySelectorAll("a").forEach((link) => {
    link.setAttribute("target", "_blank")
  })
</script>

<Layout title="projects">
  <div class="p-2 md:p-8 gap-4 flex flex-col">
    <div id="">
      <section class="mb-8">
        <h1 class="text-4xl font-bold mb-4 text-center">Projects showcase</h1>
        <h2 class="text-xl text-center">List with my top projects</h2>
      </section>
      <div id="osLink" class="text-center"></div>
    </div>

    <section>
      {
        projects
          .sort((a, b) => {
            const statusOrder = { "Under development": 0, "Refactor queue": 1 }
            const aStatus = statusOrder[a.frontmatter.status] ?? 2
            const bStatus = statusOrder[b.frontmatter.status] ?? 2
            if (aStatus !== bStatus) return aStatus - bStatus

            const aStart = `${a.frontmatter.start}-01`
            const bStart = `${b.frontmatter.start}-01`
            if (a.frontmatter.start === "current") {
              return -1
            }
            if (b.frontmatter.start === "current") {
              return 1
            }
            return dayjs(aStart).isBefore(dayjs(bStart)) ? 1 : -1
          })
          .map((project) => {
            return <project.Content />
          })
      }
    </section>
  </div>
</Layout>
